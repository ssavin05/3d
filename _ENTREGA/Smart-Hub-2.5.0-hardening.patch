-    celda.className = "zona" + (todosOcupados(espacio) ? " lleno" : "");
-    if (id === seccionActualId) celda.classList.add("seleccionada");
-    celda.innerHTML = `${espacio.nombre}<span class="cap">${espacio.capacidad} personas</span>`;
-    celda.onclick = () => seleccionarZona(id);
-    mapaEl.appendChild(celda);
-  });
-}
-
-function seleccionarZona(id) {

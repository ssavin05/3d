-<script>
-/*
-  =====================================================================
-  Panel de administrador: permite crear/editar edificios, pisos y
-  espacios (incluyendo precio y estado) sin tener que usar el SQL Editor.
-  Las politicas RLS (admin_modifica_edificios, admin_modifica_espacios)
-  ya se encargan de que solo un admin de la organizacion pueda usar esto.
-  =====================================================================
-*/
-const SUPABASE_URL = "https://xashvchjvsmwyrbxwomd.supabase.co";
-const SUPABASE_ANON_KEY = "sb_publishable_5kJ0n19pWLvyhJuANLFwIw_nqwvn4RA";
-
-const almacenamientoPersonalizado = {
-  getItem: (clave) => {
-    const recordar = localStorage.getItem("recordarme") !== "false";
-    return recordar ? window.localStorage.getItem(clave) : window.sessionStorage.getItem(clave);
-  },
-  setItem: (clave, valor) => {
-    const recordar = localStorage.getItem("recordarme") !== "false";
-    if (recordar) { window.localStorage.setItem(clave, valor); }
-    else { window.sessionStorage.setItem(clave, valor); }
-  },
-  removeItem: (clave) => {
-    window.localStorage.removeItem(clave);
-    window.sessionStorage.removeItem(clave);
-  }
-};
-
-const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
-  auth: { storage: almacenamientoPersonalizado, persistSession: true, autoRefreshToken: true }
-});
-
-let organizacionActual = null;
-let edificiosCache = [];
-let pisosCache = [];
-
-async function iniciar() {
-  const { data: sesionData } = await supabaseClient.auth.getSession();
-  if (!sesionData.session) {
-    mostrarBloqueo("Inicia sesión para continuar", "Necesitas una cuenta para entrar al panel.");
-    return;
-  }
-
-  const { data: orgs } = await supabaseClient.from("organizaciones").select("id, nombre").limit(1);
-  if (!orgs || orgs.length === 0) {
-    mostrarBloqueo("No perteneces a ninguna organización", "Pide que te agreguen a una organización primero.");
-    return;
-  }
-  organizacionActual = orgs[0];
-
-  // Verificar que sea admin (no solo miembro)
-  const { data: membresia } = await supabaseClient
-    .from("organizacion_usuarios")
-    .select("rol_id")
-    .eq("organizacion_id", organizacionActual.id)
-    .eq("usuario_id", sesionData.session.user.id)
-    .single();
-
-  if (!membresia || membresia.rol_id !== 1) {
-    mostrarBloqueo("Acceso solo para administradores", "Tu cuenta no tiene permisos de administrador en esta organización.");
-    return;
-  }
-
-  document.getElementById("nombre-org").textContent = organizacionActual.nombre;
-  document.getElementById("pantalla-carga").style.display = "none";
-  document.getElementById("panel").style.display = "block";
-
-  await cargarTodo();
-}
-
-function mostrarBloqueo(titulo, texto) {
-  document.getElementById("pantalla-carga").style.display = "none";
-  document.getElementById("pantalla-bloqueo").style.display = "block";
-  document.getElementById("titulo-bloqueo").textContent = titulo;
-  document.getElementById("texto-bloqueo").textContent = texto;
-}
-
-async function cargarTodo() {
-  await cargarEstadisticas();
-  await cargarEdificios();
-  await cargarPisos();
-  await cargarEspacios();
-}
-
-// ----------------------------------------------------------
-// ESTADISTICAS
-// ----------------------------------------------------------
-async function cargarEstadisticas() {
-  const { data: reservas, error } = await supabaseClient
-    .from("reservas")
-    .select("id, estado_id, espacio_id, espacios(nombre), horarios_disponibles(precio)")
-    .eq("organizacion_id", organizacionActual.id);
-
-  if (error || !reservas) return;
-
-  const total = reservas.length;
-  const confirmadas = reservas.filter(r => r.estado_id === 2 || r.estado_id === 4).length;
-  const canceladas = reservas.filter(r => r.estado_id === 3).length;
-
-  // Ingresos: solo cuenta reservas confirmadas o finalizadas (no pendientes ni canceladas)
-  const ingresos = reservas
-    .filter(r => r.estado_id === 2 || r.estado_id === 4)
-    .reduce((suma, r) => suma + (r.horarios_disponibles?.precio || 0), 0);
-
-  document.getElementById("stat-total-reservas").textContent = total;
-  document.getElementById("stat-confirmadas").textContent = confirmadas;
-  document.getElementById("stat-canceladas").textContent = canceladas;
-  document.getElementById("stat-ingresos").textContent = "$" + ingresos.toLocaleString("es-MX");
-
-  // Espacios mas reservados (contando todas menos las canceladas)
-  const conteoPorEspacio = {};
-  reservas.filter(r => r.estado_id !== 3).forEach(r => {
-    const nombre = r.espacios?.nombre || "Espacio eliminado";
-    conteoPorEspacio[nombre] = (conteoPorEspacio[nombre] || 0) + 1;
-  });
-
-  const topEspacios = Object.entries(conteoPorEspacio)
-    .sort((a, b) => b[1] - a[1])
-    .slice(0, 5);
-
-  document.getElementById("lista-espacios-top").innerHTML = topEspacios.length
-    ? topEspacios.map(([nombre, cuenta]) => `
-        <div class="fila-espacio-top"><span>${nombre}</span><span>${cuenta} reserva(s)</span></div>
-      `).join("")
-    : `<p style="color:var(--text-dim); font-size:13px;">Aún no hay reservas.</p>`;
-}
-
-// ----------------------------------------------------------
-// EDIFICIOS
-// ----------------------------------------------------------
-async function cargarEdificios() {
-  const { data } = await supabaseClient
-    .from("edificios")
-    .select("id, nombre, ciudad, pais")
-    .eq("organizacion_id", organizacionActual.id)
-    .order("nombre");
-
-  edificiosCache = data || [];
-
-  document.getElementById("tabla-edificios").innerHTML = edificiosCache.map(ed => `
-    <tr><td>${ed.nombre}</td><td>${ed.ciudad || "-"}</td><td>${ed.pais || "-"}</td></tr>
-  `).join("") || `<tr><td colspan="3" style="color:var(--text-dim)">Sin edificios todavía.</td></tr>`;
-
-  const selectPiso = document.getElementById("nuevo-piso-edificio");
-  selectPiso.innerHTML = edificiosCache.map(ed => `<option value="${ed.id}">${ed.nombre}</option>`).join("");
-}
-
-async function crearEdificio() {
-  const nombre = document.getElementById("nuevo-edificio-nombre").value.trim();
-  const direccion = document.getElementById("nuevo-edificio-direccion").value.trim();
-  const ciudad = document.getElementById("nuevo-edificio-ciudad").value.trim();
-  const pais = document.getElementById("nuevo-edificio-pais").value.trim();
-
-  if (!nombre) {
-    mostrarMensajeSeccion("mensaje-edificios", "El nombre es obligatorio.", "error");
-    return;
-  }
-
-  const { error } = await supabaseClient.from("edificios").insert({
-    organizacion_id: organizacionActual.id, nombre, direccion, ciudad, pais
-  });
-
-  if (error) {
-    mostrarMensajeSeccion("mensaje-edificios", "Error: " + error.message, "error");
-    return;
-  }
-
-  mostrarMensajeSeccion("mensaje-edificios", "Edificio creado.", "exito");
-  document.getElementById("nuevo-edificio-nombre").value = "";
-  document.getElementById("nuevo-edificio-direccion").value = "";
-  document.getElementById("nuevo-edificio-ciudad").value = "";
-  document.getElementById("nuevo-edificio-pais").value = "";
-  await cargarEdificios();
-}
-
-// ----------------------------------------------------------
-// PISOS
-// ----------------------------------------------------------
-async function cargarPisos() {
-  const { data } = await supabaseClient
-    .from("pisos")
-    .select("id, nombre, numero, edificio_id, edificios(nombre)")
-    .order("numero");
-
-  pisosCache = data || [];
-
-  document.getElementById("tabla-pisos").innerHTML = pisosCache.map(p => `
-    <tr><td>${p.edificios?.nombre || "-"}</td><td>${p.nombre}</td><td>${p.numero}</td></tr>
-  `).join("") || `<tr><td colspan="3" style="color:var(--text-dim)">Sin pisos todavía.</td></tr>`;
-
-  const selectEspacio = document.getElementById("nuevo-espacio-piso");
-  selectEspacio.innerHTML = pisosCache.map(p =>
-    `<option value="${p.id}">${p.edificios?.nombre || ""} - ${p.nombre}</option>`
-  ).join("");
-}
-
-async function crearPiso() {
-  const edificioId = document.getElementById("nuevo-piso-edificio").value;
-  const nombre = document.getElementById("nuevo-piso-nombre").value.trim();
-  const numero = parseInt(document.getElementById("nuevo-piso-numero").value);
-
-  if (!edificioId || !nombre || isNaN(numero)) {
-    mostrarMensajeSeccion("mensaje-pisos", "Completa edificio, nombre y número.", "error");
-    return;
-  }
-
-  const { error } = await supabaseClient.from("pisos").insert({ edificio_id: edificioId, nombre, numero });
-
-  if (error) {
-    mostrarMensajeSeccion("mensaje-pisos", "Error: " + error.message, "error");
-    return;
-  }
-
-  mostrarMensajeSeccion("mensaje-pisos", "Piso creado.", "exito");
-  document.getElementById("nuevo-piso-nombre").value = "";
-  document.getElementById("nuevo-piso-numero").value = "";
-  await cargarPisos();
-}
-
-// ----------------------------------------------------------
-// ESPACIOS (incluye editar precio/capacidad/estado en linea)
-// ----------------------------------------------------------
-async function cargarEspacios() {
-  const { data } = await supabaseClient
-    .from("espacios")
-    .select("id, nombre, capacidad_maxima, costo_base, estado, pisos(nombre, edificios(nombre))")
-    .eq("organizacion_id", organizacionActual.id)
-    .order("nombre");
-
-  const espacios = data || [];
-
-  document.getElementById("tabla-espacios").innerHTML = espacios.map(e => `
-    <tr data-id="${e.id}">
-      <td>${e.nombre}</td>
-      <td>${e.pisos?.edificios?.nombre || ""} - ${e.pisos?.nombre || ""}</td>
-      <td><input type="number" value="${e.capacidad_maxima}" data-campo="capacidad_maxima"></td>
-      <td><input type="number" value="${e.costo_base}" data-campo="costo_base"></td>
-      <td>
-        <select data-campo="estado">
-          <option value="activo" ${e.estado === "activo" ? "selected" : ""}>Activo</option>
-          <option value="mantenimiento" ${e.estado === "mantenimiento" ? "selected" : ""}>Mantenimiento</option>
-          <option value="inactivo" ${e.estado === "inactivo" ? "selected" : ""}>Inactivo</option>
-        </select>
-      </td>
-      <td><button class="accion guardar" onclick="guardarEspacio('${e.id}', this)">Guardar</button></td>
-    </tr>
-  `).join("") || `<tr><td colspan="6" style="color:var(--text-dim)">Sin espacios todavía.</td></tr>`;
-}
-
-async function guardarEspacio(id, boton) {
-  const fila = boton.closest("tr");
-  const capacidad = parseInt(fila.querySelector('[data-campo="capacidad_maxima"]').value);
-  const costo = parseFloat(fila.querySelector('[data-campo="costo_base"]').value);
-  const estado = fila.querySelector('[data-campo="estado"]').value;
-
-  boton.disabled = true;
-  boton.textContent = "Guardando...";
-
-  const { error } = await supabaseClient
-    .from("espacios")
-    .update({ capacidad_maxima: capacidad, costo_base: costo, estado })
-    .eq("id", id);
-
-  boton.disabled = false;
-  boton.textContent = "Guardar";
-
-  if (error) {
-    mostrarMensajeSeccion("mensaje-espacios", "Error: " + error.message, "error");

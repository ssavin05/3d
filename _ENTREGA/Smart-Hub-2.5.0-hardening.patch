-    };
-  });
-
-  document.getElementById("btn-reservar").onclick = reservarHorarioSeleccionado;
-}
-
-// -----------------------------------------------------
-// Esta es la funcion clave: inserta la reserva REAL en Supabase
-// -----------------------------------------------------
-async function reservarHorarioSeleccionado() {

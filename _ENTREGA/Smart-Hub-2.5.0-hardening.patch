-async function iniciar() {
-  // 1. Revisar si hay sesion activa. Sin login, RLS no deja ver nada.
-  const { data: sesionData } = await supabaseClient.auth.getSession();
-  if (!sesionData.session) {
-    document.getElementById("pantalla-carga").style.display = "none";
-    document.getElementById("pantalla-login").style.display = "block";
-    return;
-  }
-  usuarioActual = sesionData.session.user;
-
-  // Se lee el nombre desde la tabla "usuarios" (la fuente real y
-  // actualizada), no desde los metadatos de la sesion, que solo
-  // guardan el nombre de cuando te registraste y nunca se actualizan.
-  const { data: perfil } = await supabaseClient
-    .from("usuarios")
-    .select("nombre")
-    .eq("id", usuarioActual.id)
-    .single();
-
-  document.getElementById("texto-sesion").textContent =
-    "Sesión iniciada como " + (perfil?.nombre || usuarioActual.email);
-
-  // 2. Traer la primera organizacion a la que pertenece este usuario
-  const { data: orgs, error: errorOrg } = await supabaseClient
-    .from("organizaciones")
-    .select("id, nombre")
-    .limit(1);
-
-  if (errorOrg || !orgs || orgs.length === 0) {
-    document.getElementById("pantalla-carga").textContent =
-      "No perteneces a ninguna organización todavía.";
-    return;
-  }

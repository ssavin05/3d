-
-  let horariosHtml = "";
-  if (e.horarios.length === 0) {
-    horariosHtml = `<p class="subtitle" style="text-align:left">Sin horarios cargados todavía.</p>`;
-  }
-  e.horarios.forEach(h => {
-    const ocupado = h.estado !== "disponible";

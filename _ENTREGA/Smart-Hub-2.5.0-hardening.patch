-/* ---------- galería / carrusel ---------- */
-function isImageUrl(src) {
-  return /^https?:\/\//.test(src) || src.startsWith("/") || src.startsWith("data:") || /\.(jpe?g|png|webp|gif|avif)$/i.test(src);
-}
-
-function slideMarkup(src, icon) {

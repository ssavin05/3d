-  if (!roomId) return;
-  const mesh = roomMeshById[roomId];
-  if (!mesh) return;
-  mesh.scale.setScalar(1);
-  if (!mesh.userData.room.bookable) return;
-  mesh.material.emissiveIntensity = 0.5;

-/* Selector de fecha: cuántos días hacia adelante se muestran */
-const DAYS_COUNT = 6;
-
-/* Alturas de los volúmenes 3D */
-const HEIGHT_MUTE = 0.9;   // espacios informativos (no reservables)
-const HEIGHT_BOOK = 1.35;  // espacios reservables

-  const hues = ["linear-gradient(135deg,#123249,#1d4a6b)", "linear-gradient(135deg,#1c2b3d,#123249)", "linear-gradient(135deg,#0d1420,#1c2b3d)"];
-  const g = hues[galleryIdx % hues.length];
